{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    ".generated",              // ✅ allows vue-tsc to find auto-generated types
    ".generated/*.d.ts"
  ],
  "compilerOptions": {
    /* Target */
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler", // ✅ required for Vite/virtual modules
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "jsx": "preserve",
    "sourceMap": true,
    "esModuleInterop": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Emit */
    "composite": true,

    "baseUrl": "./src/",
    "paths": {
      "~/*": ["./"],
      "assets/*": ["assets/*"],
      "components/*": ["components/*"],
      "pages/*": ["pages/*"],
      "stores/*": ["stores/*"]
    },

    // ✅ Tell TS about unplugin-vue-router virtual module
    "types": ["unplugin-vue-router/client"]
  },
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
